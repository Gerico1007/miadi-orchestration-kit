[Desktop Entry]
Type=Application
Name=Miadi Chronicle reference
Comment=Open a miadi-chronicle:, miadi-ceremony:, miadi-circle: or miadi-foundation: reference in the browser
Exec=/usr/bin/miadi-chronicle-open --open %u
MimeType=x-scheme-handler/miadi-chronicle;x-scheme-handler/miadi-ceremony;x-scheme-handler/miadi-circle;x-scheme-handler/miadi-foundation;
NoDisplay=true
Terminal=false
