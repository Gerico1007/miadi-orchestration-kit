Session names may contain colons: prefer the longest prefix of a target that names a session.
miadi names sessions after circle ids (circle:1791110394383:jj1ql8), which stay clickable.
Without this, tmux attach -t a:b:c answers "can't find window: b:c". jgwill/gaia#90

--- a/cmd-find.c
+++ b/cmd-find.c
@@ -916,6 +916,36 @@
 }
 
 /*
+ * Session names may contain colons: miadi names sessions after circle ids such as
+ * circle:1791110394383:jj1ql8. Return the colon that ends the longest prefix of copy
+ * that names a session and contains a colon itself, the terminating NUL when the
+ * whole of copy names such a session, or NULL so the first colon separates as usual.
+ */
+static char *
+cmd_find_session_colon(char *copy)
+{
+	char	*name = copy, *cp;
+
+	if (*name == '=')
+		name++;
+	if (strchr(name, ':') == NULL)
+		return (NULL);
+	if (session_find(name) != NULL)
+		return (copy + strlen(copy));
+	for (cp = copy + strlen(copy) - 1; cp > name; cp--) {
+		if (*cp != ':')
+			continue;
+		*cp = '\0';
+		if (strchr(name, ':') != NULL && session_find(name) != NULL) {
+			*cp = ':';
+			return (cp);
+		}
+		*cp = ':';
+	}
+	return (NULL);
+}
+
